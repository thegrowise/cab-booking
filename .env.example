# GoWise project API key (Settings → API keys in the GoWise dashboard)
NUXT_PUBLIC_GROWISE_API_KEY=

# GoWise environment the SDK sends to: local | dev | qc | stag | uat | prod (dev = qc servers).
# Leave unset and the SDK picks "local" on localhost (localhost:8083) and "prod" elsewhere,
# so set it when testing against QC from a local machine or a non-prod deploy.
NUXT_PUBLIC_GROWISE_ENV=qc

# Dev/QA panel. In `npm run dev` it shows unless this is "false"; production builds
# ignore it and show the panel only when NUXT_PUBLIC_DEV_PANEL_IN_PRODUCTION=true.
NUXT_PUBLIC_DEV_PANEL=true
NUXT_PUBLIC_DEV_PANEL_IN_PRODUCTION=false
